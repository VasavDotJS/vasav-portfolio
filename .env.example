# Contact form ------------------------------------------------------------
# "resend" (default) sends through Resend; "web3forms" posts to Web3Forms instead.
CONTACT_PROVIDER=resend

# Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Where form messages land.
CONTACT_TO_EMAIL=vasavpramesh06@gmail.com
# Until you verify a domain in Resend, keep the onboarding sender. It can only
# deliver to the email address that owns the Resend account.
CONTACT_FROM_EMAIL="portfolio <onboarding@resend.dev>"

# Web3Forms alternative (only used when CONTACT_PROVIDER=web3forms)
WEB3FORMS_ACCESS_KEY=

# Optional: raises the GitHub API rate limit for the "last push" ticker.
GITHUB_TOKEN=
